---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const publishedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const hero = publishedPosts[0];
const morePosts = publishedPosts.slice(1, 6);

const heroDate = hero
  ? new Date(hero.data.date).toLocaleDateString('zh-TW', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
---

<Layout title="旅行日記 - 記錄每一段旅程" transparentHeader={true}>
  {hero && (
    <section class="hero" style={hero.data.cover ? `background-image: url(${hero.data.cover})` : ''}>
      <div class="hero-shade"></div>
      <div class="hero-text">
        <p class="kicker">最新遊記 · {heroDate} · {hero.data.location}</p>
        <h1>{hero.data.title}</h1>
        <a class="button" href={`/travel-journal/posts/${hero.slug}`}>閱讀這篇</a>
      </div>
    </section>
  )}

  <div class="container">
    <h2 class="section-title">近期遊記</h2>
    <div class="mosaic">
      {morePosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
    <div class="view-all">
      <a href="/travel-journal/posts" class="button">查看全部 {publishedPosts.length} 篇遊記</a>
    </div>

    <section class="about-preview">
      <h2>關於這本日記</h2>
      <p>
        這是我個人的旅行日記，從台灣的山海到更遠的地方，
        也記下在地的音樂會、活動與日常。每一篇都只寫照片裡看得到的事。
      </p>
      <a href="/travel-journal/about" class="more">了解更多 →</a>
    </section>
  </div>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    background-color: var(--dark);
    background-size: cover;
    background-position: center;
    color: #fff;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 15, 12, 0.8) 0%, rgba(20, 15, 12, 0.25) 50%, rgba(20, 15, 12, 0.35) 100%);
  }

  .hero-text {
    position: relative;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  .kicker {
    font-size: 0.9rem;
    letter-spacing: 0.15em;
    opacity: 0.9;
    margin-bottom: 0.8rem;
  }

  .hero h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.25;
    max-width: 900px;
    margin-bottom: 1.6rem;
  }

  .view-all {
    text-align: center;
  }

  .about-preview {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .about-preview h2 {
    font-family: var(--serif);
    font-size: 1.6rem;
    margin-bottom: 1rem;
  }

  .about-preview p {
    max-width: 620px;
    margin: 0 auto 1rem;
    color: #5d544d;
    line-height: 1.9;
  }

  .more {
    color: var(--accent);
    text-decoration: none;
    letter-spacing: 0.06em;
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 80vh;
    }

    .hero-text {
      padding: 0 1rem 2.5rem;
    }
  }
</style>
