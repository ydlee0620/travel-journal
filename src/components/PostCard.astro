---
interface Props {
  post: any;
}

const { post } = Astro.props;
const { title, date, location, cover, tags } = post.data;

const formattedDate = new Date(date).toLocaleDateString('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <a href={`/travel-journal/posts/${post.slug}`}>
    {cover ? <img src={cover} alt={title} loading="lazy" onerror="this.style.display='none'" /> : <div class="no-cover"></div>}
    <div class="shade"></div>
    <div class="post-info">
      <div class="post-meta">
        <span>{formattedDate}</span>
        <span>{location}</span>
      </div>
      <h3>{title}</h3>
      {tags && tags.length > 0 && (
        <div class="tags">
          {tags.slice(0, 3).map((tag: string) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .post-card {
    position: relative;
    overflow: hidden;
    background: var(--dark);
    height: 100%;
  }

  .post-card a {
    display: block;
    height: 100%;
    color: #fff;
    text-decoration: none;
    position: relative;
  }

  .post-card img,
  .no-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .no-cover {
    background: linear-gradient(135deg, #5c4a3d, #2b2623);
  }

  .post-card:hover img {
    transform: scale(1.06);
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 15, 12, 0.85) 0%, rgba(20, 15, 12, 0.15) 55%, transparent 100%);
  }

  .post-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.25rem 1.4rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    opacity: 0.85;
    margin-bottom: 0.35rem;
  }

  h3 {
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 700;
  }

  :global(.mosaic > :nth-child(5n + 1)) h3 {
    font-size: 1.6rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    opacity: 0.8;
  }
</style>
