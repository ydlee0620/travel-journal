---
interface Props {
  title: string;
  transparentHeader?: boolean;
}

const { title, transparentHeader = false } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="旅行日記 - 記錄每一段旅程的光影" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/travel-journal/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class:list={['site-header', { overlay: transparentHeader }]}>
      <nav class="nav-container">
        <a class="logo" href="/travel-journal/">旅行日記</a>
        <ul class="nav-links">
          <li><a href="/travel-journal/">首頁</a></li>
          <li><a href="/travel-journal/posts">遊記</a></li>
          <li><a href="/travel-journal/about">關於</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>© {new Date().getFullYear()} 旅行日記 · 記錄每一段旅程的光影</p>
    </footer>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --accent: #b4572e;
    --accent-dark: #8f4423;
    --ink: #2b2623;
    --muted: #8a7f76;
    --paper: #faf7f2;
    --line: #e8e1d8;
    --dark: #1f1b18;
    --serif: 'Noto Serif TC', 'Songti TC', 'PMingLiU', serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans TC',
      'Microsoft JhengHei', sans-serif;
  }

  html {
    font-family: var(--sans);
    background: var(--paper);
    scroll-behavior: smooth;
  }

  body {
    color: var(--ink);
    line-height: 1.7;
  }

  a {
    color: inherit;
  }

  /* header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 247, 242, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .site-header.overlay {
    position: absolute;
    left: 0;
    right: 0;
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
    color: #fff;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .nav-links a {
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .nav-links a:hover {
    opacity: 1;
  }

  /* layout helpers */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  main {
    min-height: calc(100vh - 160px);
  }

  .section-title {
    font-family: var(--serif);
    font-size: 1.8rem;
    letter-spacing: 0.06em;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  /* magazine mosaic grid shared by home and list pages */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 280px;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .mosaic > :nth-child(5n + 1) {
    grid-column: span 2;
  }

  /* avoid holes in the last row */
  .mosaic > :nth-child(5n + 1):last-child,
  .mosaic > :nth-child(5n + 3):last-child {
    grid-column: span 3;
  }

  .mosaic > :nth-child(5n + 4):last-child {
    grid-column: span 2;
  }

  .button {
    display: inline-block;
    padding: 0.7rem 2rem;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    letter-spacing: 0.08em;
    font-size: 0.95rem;
    transition: background 0.2s;
  }

  .button:hover {
    background: var(--accent-dark);
  }

  .button.ghost {
    background: transparent;
    border: 1px solid #fff;
  }

  .button.ghost:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  footer {
    text-align: center;
    padding: 2rem;
    margin-top: 3rem;
    color: var(--muted);
    font-size: 0.9rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .mosaic {
      grid-template-columns: repeat(2, 1fr);
    }

    .mosaic > :nth-child(n) {
      grid-column: span 1;
    }

    .mosaic > :nth-child(5n + 1) {
      grid-column: span 2;
    }

    .mosaic > :last-child:nth-child(n) {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .nav-container {
      padding: 0.8rem 1rem;
    }

    .nav-links {
      gap: 1.1rem;
    }

    .container {
      padding: 2rem 1rem;
    }

    .mosaic {
      grid-template-columns: 1fr;
      grid-auto-rows: 240px;
    }

    .mosaic > :nth-child(n),
    .mosaic > :last-child:nth-child(n) {
      grid-column: span 1;
    }
  }
</style>
